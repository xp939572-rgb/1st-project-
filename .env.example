# .env.example
# Copy this file to .env for LOCAL development only (and add .env to
# .gitignore — never commit real values). In production, set these in
# Vercel → Project Settings → Environment Variables instead.
#
# Every value below is a placeholder. Do not put real secrets in this file.

# ---------- PayFast ----------
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_BASE_URL=

# ---------- Payment mode ----------
# sandbox    = PayFast's sandbox/test environment (once wired up)
# production = real PayFast production environment — real money
# mock       = local testing only; NEVER allowed when VERCEL_ENV=production
#              (api/create-payment.js hard-refuses mock mode in production)
PAYMENT_MODE=sandbox

# ---------- Email (Resend) ----------
EMAIL_API_KEY=
EMAIL_FROM="Saba Muzaffer Kayani <bookings@yourdomain.com>"
BOOKING_NOTIFICATION_EMAIL=Sabamuzaffar9@gmail.com

# ---------- Database ----------
DATABASE_URL=

# ---------- Site ----------
# Used to build PayFast return URLs and email links. REQUIRED in production —
# api/create-payment.js and api/payfast-return.js will refuse to build a
# redirect URL from the client-supplied Host header instead of guessing one,
# since that header is spoofable. Set this to your real production domain.
SITE_URL=

# ---------- Rate limiting (Upstash Redis) ----------
# Protects /api/create-booking, /api/create-payment, and /api/booking-status
# from scripted abuse. Free tier at upstash.com is enough for this traffic
# volume. If left unset, requests are allowed through unrestricted and a
# warning is logged — set these before taking the booking form fully public.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
